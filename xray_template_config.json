{
  "api": {
    "tag": "api",
    "services": [
      "HandlerService",
      "LoggerService",
      "StatsService",
      "RoutingService"
    ]
  },
  "stats": {},
  "policy": {
    "levels": {
      "0": {
        "statsUserUplink": true,
        "statsUserDownlink": true
      }
    },
    "system": {
      "statsInboundUplink": true,
      "statsInboundDownlink": true,
      "statsOutboundUplink": true,
      "statsOutboundDownlink": true
    }
  },
  "inbounds": [
    {
      "tag": "api",
      "listen": "127.0.0.1",
      "port": 62789,
      "protocol": "dokodemo-door",
      "settings": {
        "address": "127.0.0.1"
      }
    }
  ],
  "outbounds": [
    {
      "tag": "direct",
      "protocol": "freedom",
      "settings": {
        "domainStrategy": "UseIPv4"
      }
    },
    {
      "tag": "warp-socks",
      "protocol": "socks",
      "settings": {
        "servers": [
          {
            "address": "127.0.0.1",
            "port": 40000
          }
        ]
      }
    },
    {
      "tag": "blocked",
      "protocol": "blackhole",
      "settings": {
        "response": {
          "type": "http"
        }
      }
    }
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "type": "field",
        "inboundTag": [
          "api"
        ],
        "outboundTag": "api"
      },
      {
        "type": "field",
        "outboundTag": "blocked",
        "protocol": [
          "bittorrent"
        ]
      },
      {
        "type": "field",
        "outboundTag": "blocked",
        "ip": [
          "geoip:private"
        ]
      },
      {
        "type": "field",
        "outboundTag": "blocked",
        "domain": [
          "geosite:category-ads-all"
        ]
      },
      {
        "type": "field",
        "outboundTag": "blocked",
        "port": "443",
        "network": "udp",
        "domain": [
          "geosite:openai",
          "geosite:anthropic",
          "geosite:perplexity",
          "domain:openai.com",
          "domain:chatgpt.com",
          "domain:anthropic.com",
          "domain:claude.ai",
          "domain:perplexity.ai"
        ]
      },
      {
        "type": "field",
        "outboundTag": "warp-socks",
        "domain": [
          "geosite:openai",
          "geosite:anthropic",
          "geosite:perplexity",
          "domain:openai.com",
          "domain:chatgpt.com",
          "domain:oaistatic.com",
          "domain:oaiusercontent.com",
          "domain:sora.com",
          "domain:ai.com",
          "domain:chat.openai.com",
          "domain:auth0.openai.com",
          "domain:client-api.arkoselabs.com",
          "domain:featuregates.org",
          "domain:statsig.com",
          "domain:statsigapi.net",
          "domain:anthropic.com",
          "domain:claude.ai",
          "domain:claude.com",
          "domain:cursor.sh",
          "domain:cursor.com",
          "domain:cursor-cdn.com",
          "domain:copilot.microsoft.com",
          "domain:perplexity.ai",
          "domain:midjourney.com",
          "domain:x.ai",
          "domain:grok.com",
          "domain:deepseek.com",
          "domain:mistral.ai",
          "domain:cohere.com"
        ]
      },
      {
        "type": "field",
        "outboundTag": "direct",
        "network": "tcp,udp"
      }
    ]
  },
  "dns": {
    "servers": [
      "https://1.1.1.1/dns-query",
      "https://8.8.8.8/dns-query",
      "1.1.1.1",
      "8.8.8.8",
      "localhost"
    ],
    "queryStrategy": "UseIPv4"
  }
}